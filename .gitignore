# macOS
.DS_Store

# secrets — the real local settings must never be committed
claude/settings.local.json

# vim runtime
vim/.vim/undo/
vim/.vim/.netrwhist
.vim/

# ble.sh runtime cache (created when ble.sh is sourced from the vendored copy)
tools/blesh/cache.d/
tools/blesh/run/

# Python bytecode cache (gen-screenshots.py gets imported by ad-hoc probes)
__pycache__/
